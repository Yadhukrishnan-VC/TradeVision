# =============================================================================
# TradeVision AI — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -----------------------------------------------------------------------------
# PostgreSQL (primary database)
# -----------------------------------------------------------------------------
POSTGRES_DB=tradevision_db
POSTGRES_USER=tradevision
POSTGRES_PASSWORD=tradevision_password
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432

# Full DSN — points to pgbouncer, NOT postgres directly
DATABASE_URL=postgresql://tradevision:tradevision_password@pgbouncer:6432/tradevision_db

# TimescaleDB — same instance, separate DSN alias for explicit use
TIMESCALE_URL=postgresql://tradevision:tradevision_password@pgbouncer:6432/tradevision_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# -----------------------------------------------------------------------------
# AI Providers — only the active provider key is required
# -----------------------------------------------------------------------------
# Active provider: gemini | openai | claude | ollama
AI_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# -----------------------------------------------------------------------------
# AI Governance
# -----------------------------------------------------------------------------
# Minimum confidence score to deliver a recommendation to users (0.0–1.0)
AI_CONFIDENCE_FLOOR=0.55
# Hard daily cost budget in USD — enforced via Redis counter
AI_DAILY_BUDGET_USD=10.00
# Suppress repeat AI calls for same symbol+event within this window (seconds)
AI_DEDUP_WINDOW_SECONDS=300
# Maximum tokens per AI prompt (prevents runaway context costs)
AI_MAX_TOKENS=4096
# Latency threshold (ms) before a provider health status becomes "degraded"
AI_HEALTH_DEGRADED_THRESHOLD_MS=2000
# Model Router: ordered provider priority (most-preferred first, comma-separated)
AI_PROVIDER_PRIORITY=claude,gemini,openai,deepseek,ollama
# Model Router: manually disabled providers (comma-separated, default empty)
AI_PROVIDER_DISABLED=
# Model Router: latency budget (ms) below which only FAST tier providers qualify
AI_ROUTING_FAST_TIER_THRESHOLD_MS=1500

# -----------------------------------------------------------------------------
# Circuit Breaker (resilience)
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_EXPECTED_EXCEPTION=Exception

# -----------------------------------------------------------------------------
# Market Data Sources
# -----------------------------------------------------------------------------
# NSE/BSE data vendor API key
NSE_API_KEY=your-nse-api-key-here
NSE_API_BASE_URL=https://api.example-nse-vendor.com/v1

# News API
NEWS_API_KEY=your-news-api-key-here
NEWS_API_BASE_URL=https://newsapi.org/v2

# Corporate announcements feed
ANNOUNCEMENT_FEED_URL=https://www.bseindia.com/corporates/ann.html
NSE_ANNOUNCEMENT_URL=https://www.nseindia.com/companies-listing/corporate-filings-announcements

# Global markets
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
JWT_AUTH_HEADER_PREFIX=Bearer

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TradeVision AI <noreply@tradevision.ai>

# -----------------------------------------------------------------------------
# Frontend (Vite — prefix must be VITE_)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WS_BASE_URL=ws://localhost/ws
VITE_APP_NAME=TradeVision AI
VITE_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry DSN (production only — leave blank in development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus metrics endpoint toggle
PROMETHEUS_METRICS_ENABLED=True

# Structured log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Market Calendar
# -----------------------------------------------------------------------------
# Timezone for all market operations
MARKET_TIMEZONE=Asia/Kolkata
# Exchange: NSE | BSE
MARKET_EXCHANGE=NSE

# -----------------------------------------------------------------------------
# Data Quality
# -----------------------------------------------------------------------------
# Maximum age (seconds) of tick data before considered stale
TICK_FRESHNESS_THRESHOLD_SECONDS=120
# Maximum age (seconds) of indicator data before considered stale
INDICATOR_FRESHNESS_THRESHOLD_SECONDS=300
# Minimum data quality score (0.0–1.0) to trigger rule evaluation
INTELLIGENCE_MIN_QUALITY_SCORE=0.60
