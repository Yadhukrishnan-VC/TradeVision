# =============================================================================
# TradeVision AI — .gitignore
# =============================================================================

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Backups — never commit database dumps
backups/
*.sql
*.sql.gz
*.rdb

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
.Python
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec

# Virtual environments
.venv/
venv/
ENV/
env/
.env.bak

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
mediafiles/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
coverage/

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Linting
.ruff_cache/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.vite/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker
*.pid

# Celery
celerybeat-schedule
celerybeat.pid

# TimescaleDB / Postgres
*.dump

# Jupyter
.ipynb_checkpoints/

# Temporary
tmp/
temp/
*.tmp
*.bak
*.orig
