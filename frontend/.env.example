# TradeVision frontend — environment configuration
#
# Backend API base URL. Must include the /api/v1 suffix.
# Examples:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#   VITE_API_BASE_URL=https://api.tradevision.example/api/v1
#
# Leave unset to use relative /api/v1 (works when frontend is served
# from the same origin as the backend).
#
# VITE_API_BASE_URL=

# Optional: smoke test credentials (used by scripts/smoke.ts only)
# SMOKE_USERNAME=
# SMOKE_PASSWORD=
